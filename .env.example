# ==============================================================================
# SRI BALAJI GEARS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production
APP_URL=https://www.sribalajigears.com

# Enquiry Destination Email
ERP_EMAIL=erp@sribalajigears.com
COMPANY_NAME="Sri Balaji Gears"

# SMTP Email Configuration (Optional - falls back to PHP mail() if empty)
# If using Gmail, use an App Password: https://myaccount.google.com/apppasswords
# If using cPanel / Webmail: use mail.sribalajigears.com or your webhost SMTP
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM_EMAIL=erp@sribalajigears.com
SMTP_FROM_NAME="Sri Balaji Gears RFQ Portal"

# Admin Dashboard Credentials
# Default login: Username = admin, Password = ChangeMeInProduction2026!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeInProduction2026!

# Upload & Database Settings
MAX_UPLOAD_SIZE_MB=15
DB_PATH=../data/enquiries.db
