# Sri Balaji Gears - Production Apache / cPanel / Render Configuration
DirectoryIndex index.html

# 0. Prevent Directory Indexing and Traversal
Options -Indexes -MultiViews

# 1. Comprehensive Enterprise HTTP Security Headers
<IfModule mod_headers.c>
  # Protect against MIME-type confusion attacks
  Header always set X-Content-Type-Options "nosniff"

  # Prevent Clickjacking by restricting framing to same-origin
  Header always set X-Frame-Options "SAMEORIGIN"

  # Enable legacy browser XSS filters
  Header always set X-XSS-Protection "1; mode=block"

  # Modern Referrer Policy: Send full referrer on same origin, only origin on HTTPS cross-origin
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict dangerous device permissions (Camera, Mic, Location)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # Enforce HTTPS HSTS for 1 year with subdomains and preload
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# 2. Force HTTPS (Safe behind reverse proxies like Render / Cloudflare)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Clean URLs (allow opening /about without .html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [NC,L]
</IfModule>

# 3. Enable Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 4. Cache Control: Never cache HTML to guarantee live updates; revalidate JS/CSS
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# 5. Leverage Browser Caching for static assets (images, fonts)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 6. Strict Security Rules: Block sensitive configuration, environment, database, and repository files
<FilesMatch "^\.env|\.git|\.db$|\.sqlite$|\.sql$|\.log$|\.md$|composer\.(json|lock)|package(-lock)?\.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# 7. Protect Sensitive Directories (config, data, backups)
RewriteRule ^(config|data|logs)(\/.*)?$ - [F,L,NC]
